# Fan signup endpoint (Supabase/Lovable function or third-party ESP webhook).
# When unset, the fan signup form shows an optimistic success state and
# console.info()s the payload instead of calling a backend.
VITE_FAN_SIGNUP_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable GA.
VITE_GA_ID=

# Meta (Facebook) Pixel ID. Defaults to 788829401662107 in src/config/site.ts if unset.
VITE_META_PIXEL_ID=788829401662107
